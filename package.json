{
  "name": "karadial",
  "version": "0.1.0",
  "private": true,
  "description": "Speed dial new tab page for bookmarks from your self-hosted Karakeep instance.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karadial/karadial.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "overrides": {
    "minimatch": "^11.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@wxt-dev/module-svelte": "^2.0.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.0",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  }
}
